# ============================================================

# Procfile — Tells Railway How to Start Your Django App

#

# Place this file in: backend/Procfile (no file extension)

#

# "web:" means this is the command that starts the web server

# gunicorn is the production web server for Django

# portfolio.wsgi:application points to your wsgi.py file

# --bind 0.0.0.0:$PORT tells it which port Railway assigns

# ============================================================

web: gunicorn portfolio.wsgi:application --bind 0.0.0.0:$PORT
