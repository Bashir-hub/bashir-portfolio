# ============================================================
# .gitignore — Files Git Should NEVER Upload to GitHub
#
# Place this file in the ROOT of your project:
# bashir-portfolio/.gitignore
#
# Every line here is a file or folder that Git will ignore.
# This protects your passwords and keeps your repo clean.
# ============================================================


# ── Python & Django ──────────────────────────────────────────

# Compiled Python files — auto-generated, not needed on GitHub
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environment folder — very large, never upload this
# Anyone who clones your repo runs: pip install -r requirements.txt
venv/
env/
ENV/
.venv/

# Django database file — this is YOUR local data
# The server will create its own database
*.sqlite3
db.sqlite3

# Django media uploads — uploaded images stay local
# The server will have its own media folder
media/

# Django static files collection folder
staticfiles/

# Environment variables file — NEVER upload this!
# It contains your SECRET_KEY and database passwords
.env
.env.local
.env.production

# Django migration files are sometimes excluded
# But for beginners it is safer to INCLUDE them
# So we do NOT list migrations/ here


# ── Node.js & React ──────────────────────────────────────────

# Node modules folder — extremely large (100,000+ files)
# Anyone who clones runs: npm install
node_modules/

# React production build — Vercel builds this automatically
build/
dist/

# npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment files for React
.env.local
.env.development.local
.env.test.local
.env.production.local


# ── VS Code ──────────────────────────────────────────────────

# VS Code workspace settings — personal to your machine
.vscode/
*.code-workspace


# ── Operating System Files ───────────────────────────────────

# Mac OS hidden files
.DS_Store
.AppleDouble
.LSOverride

# Windows thumbnail cache files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Windows shortcut files
*.lnk


# ── Logs ─────────────────────────────────────────────────────

# Log files from various tools
*.log
logs/


# ── Miscellaneous ─────────────────────────────────────────────

# Temporary files
*.tmp
*.temp
*.swp
*.swo
